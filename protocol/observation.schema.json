{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senlay.cloud/protocol/observation/v0.1",
  "title": "Senlay Observation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["stationId", "observedAt", "location", "measurements"],
  "properties": {
    "schema": { "type": "string" },
    "id": { "type": "string", "format": "uuid" },
    "providerId": { "type": "string", "minLength": 2, "maxLength": 128 },
    "stationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
    "observedAt": { "type": "string", "format": "date-time" },
    "receivedAt": { "type": "string", "format": "date-time" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitudeM": { "type": "number" }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phenomenon", "value", "unit"],
        "properties": {
          "phenomenon": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)+$" },
          "value": { "type": "number" },
          "unit": { "enum": ["m/s", "km/h", "kt", "deg", "C", "hPa", "%", "mm", "m", "ug/m3"] },
          "quality": { "enum": ["raw", "checked", "estimated"] }
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
