SENLAY_GATEWAY_HOST=127.0.0.1
SENLAY_GATEWAY_PORT=8787
SENLAY_PROVIDER_ID=prv_REPLACE_ME
# This is the one-time station secret returned by /api/v1/stations/register.
SENLAY_SIGNING_SECRET=sl_station_replace-with-the-returned-secret
SENLAY_STATION_ID=stn_replace-with-the-returned-station-id
SENLAY_STATION_LAT=15.8801
SENLAY_STATION_LNG=108.3380
# Used only for the owner-authorized commissioning dry run.
SENLAY_ACCOUNT_API_KEY=sl_live_replace-with-an-account-api-key
# Optional authorized upstream endpoint. Leave empty for validate-only mode.
SENLAY_INGEST_URL=

# Optional MQTT-to-HTTPS bridge. The bridge signs each normalized observation
# with this station's secret before it forwards it to SENLAY_INGEST_URL.
SENLAY_MQTT_URL=mqtts://broker.example.com:8883
SENLAY_MQTT_TOPIC=senlay/observations/#
SENLAY_MQTT_USERNAME=
SENLAY_MQTT_PASSWORD=
